# Renomeie este arquivo para ".env" e preencha com as credenciais reais.
# Mantenha este arquivo na MESMA pasta do script nessus_pre_migration_audit.py.
# NUNCA versionar o .env real em repositórios (adicione ao .gitignore).

NESSUS_URL=https://nessus-host:8834

# Autenticação via API Keys (recomendado)
NESSUS_ACCESS_KEY=
NESSUS_SECRET_KEY=

# Autenticação alternativa via login/senha (usar --auth-method password)
# NESSUS_USERNAME=
# NESSUS_PASSWORD=
