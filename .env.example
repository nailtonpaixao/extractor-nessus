# Copie este arquivo para ".env" e preencha com suas credenciais reais.
# NUNCA suba o arquivo ".env" preenchido para o GitHub.

NESSUS_BASE_URL=https://localhost:8834
NESSUS_VERIFY_SSL=false

# Opção A (recomendada): API Keys
# Gere em: Nessus Pro > Settings > My Account > API Keys
NESSUS_ACCESS_KEY=
NESSUS_SECRET_KEY=

# Opção B (fallback): usuário e senha
NESSUS_USERNAME=
NESSUS_PASSWORD=
